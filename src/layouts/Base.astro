---
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/400-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
// preloaded so the first paint already uses them: a late swap moved the header and title (CLS 0.24)
import fontDisplay from '@fontsource/bodoni-moda/files/bodoni-moda-latin-400-normal.woff2?url';
import fontDisplayItalic from '@fontsource/bodoni-moda/files/bodoni-moda-latin-400-italic.woff2?url';
import fontBody from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../lib/content';

interface Props { title?: string; description?: string; wide?: boolean }
const { title, description = 'How photography came to be: an interactive timeline of its discoveries, cameras, formats and makers, with the physics of how it works.', wide = false } = Astro.props;
const fullTitle = title ? `${title} · Photography Through Time` : 'Photography Through Time';
const canonical = new URL(Astro.url.pathname, Astro.site);
// search index: detail pages get a result type; list pages (which repeat everything) stay out of the index
const path = Astro.url.pathname;
const searchType =
  /^\/entries\/[^/]+\/$/.test(path) ? 'Entry' :
  /^\/makers\/[^/]+\/$/.test(path) ? 'Maker' :
  /^\/physics\/[^/]+\/$/.test(path) ? 'How it works' :
  path === '/glossary/' ? 'Glossary' :
  ['/formats/', '/landmarks/', '/sources/', '/about/'].includes(path) ? 'Page' : null;
const { glossary } = await content();
const gloss = Object.fromEntries(glossary.map((g) => [g.id, { t: g.data.term, d: g.data.def }]));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontDisplayItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Set the theme before first paint (no flash). Storage may be unavailable.
      (function () {
        document.documentElement.classList.add('js');
        var t = null, p = null;
        try { t = localStorage.getItem('ptt-theme'); p = localStorage.getItem('ptt-palette'); } catch (e) {}
        document.documentElement.setAttribute('data-palette', /^(kodachrome|print|cyanotype|platinum)$/.test(p || '') ? p : 'kodachrome');
        if (t === 'day') document.documentElement.setAttribute('data-theme', 'light');
        else if (t === 'night') document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
  </head>
  <body>
    <a class="visually-hidden skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['wrap', { wide }]} data-pagefind-body={searchType ? '' : undefined}>
      {searchType && <span hidden data-pagefind-filter={`type:${searchType}`} data-pagefind-meta={`type:${searchType}`}></span>}
      <slot />
    </main>
    <Footer />
    <div class="gloss-pop" id="gloss-pop" role="tooltip" hidden></div>
    <script type="application/json" id="gloss-data" set:html={JSON.stringify(gloss)} />
    <script>
      import '../scripts/glossary';
    </script>
  </body>
</html>
<style is:global>
  .skip:focus { position: fixed !important; left: 12px; top: 12px; width: auto; height: auto; clip: auto; padding: 8px 12px; background: var(--raised); z-index: 50; }
  main { padding-block: 28px 56px; display: block; }
  .gloss-pop { position: fixed; z-index: 40; max-width: 320px; background: var(--raised); border: 1px solid var(--rule); border-radius: 12px; padding: 10px 12px; box-shadow: 0 10px 30px var(--shadow); font-size: 13px; line-height: 1.45; color: var(--ink-2); pointer-events: none; }
  .gloss-pop strong { display: block; color: var(--ink); font-weight: 600; margin-bottom: 2px; }
</style>
