---
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/content';
import { cropFactor, areaRatio } from '../../lib/optics';
import { url } from '../../lib/url';
import { useT, langPaths, fmtNum, type Lang } from '../../i18n';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const num = (n: number, d = 1, min = 0) => fmtNum(lang, n, d, min);
const { formats, entryById } = await content(lang);
const area = (f: (typeof formats)[number]) => f.data.w * f.data.h;
const list = [...formats].sort((a, b) => area(b) - area(a));
const GROUPS = (['large', 'medium', 'full', 'smaller', 'film-small'] as const).map((g) => [g, t(`formats.g.${g}`)] as const);
const fmtData = list.map((f) => ({ id: f.id, name: f.data.name, w: f.data.w, h: f.data.h }));
// first paint: fit full frame and its neighbours; the script re-fits to whatever is selected
const view = (w: number, h: number) => { const W = Math.max(w, 36) * 1.14, H = Math.max(h, 24) * 1.14; return `${-W / 2} ${-H / 2} ${W} ${H}`; };
const DEFAULT = 'aps-c';
// a frame-shaped icon for each Show button: the format's own aspect ratio, fitted to a 16 px box
const icon = (w: number, h: number) => { const s = 16 / Math.max(w, h), iw = w * s, ih = h * s; return { x: 10 - iw / 2, y: 10 - ih / 2, w: iw, h: ih }; };
const d0 = list.find((f) => f.id === DEFAULT)!;
---
<Base title={t('formats.title')} description={t('formats.desc')}>
  <p class="eyebrow">{t('formats.eyebrow')}</p>
  <h1 class="page-title">{t('formats.title')}</h1>
  <p class="dek" set:html={t('formats.dek', { primer: `<a href="${url('/physics/formats/', lang)}">${t('formats.primer')}</a>` })} />
  <div class="layout">
    <figure class="panel overlay">
      <svg id="ov" viewBox={view(d0.data.w, d0.data.h)} role="img" aria-labelledby="ov-cap">
        {[...list].reverse().map((f) => (
          <rect class:list={['fmt', `g-${f.data.group}`, { on: f.id === DEFAULT }]} data-id={f.id} x={-f.data.w / 2} y={-f.data.h / 2} width={f.data.w} height={f.data.h} vector-effect="non-scaling-stroke" />
        ))}
        <rect class="ff-ref" x="-18" y="-12" width="36" height="24" vector-effect="non-scaling-stroke" />
      </svg>
      <figcaption id="ov-cap"><span id="ov-text">{t('formats.against', { name: d0.data.name, w: num(d0.data.w), h: num(d0.data.h) })}</span> <span class="key"><i class="k-ff"></i>{t('formats.key.ff')} <i class="k-on"></i>{t('formats.key.on')} <i class="k-other"></i>{t('formats.key.other')}</span></figcaption>
    </figure>
    <div class="calc panel">
      <p class="kicker">{t('formats.calc')}</p>
      <label for="fmt">{t('formats.format')}</label>
      <select id="fmt">
        {GROUPS.map(([g, label]) => (
          <optgroup label={label}>{list.filter((f) => f.data.group === g).map((f) => <option value={f.id} selected={f.id === DEFAULT}>{f.data.name}</option>)}</optgroup>
        ))}
      </select>
      <label for="focal">{t('formats.focal')}</label>
      <input id="focal" type="number" min="1" max="2000" value="28" inputmode="decimal" />
      <label for="fnum">{t('formats.fnum')}</label>
      <input id="fnum" type="number" min="0.7" max="128" step="0.1" value="1.8" inputmode="decimal" />
      <p class="out" id="out" aria-live="polite"></p>
    </div>
  </div>
  <div class="table-wrap">
    <table class="fmt-table">
      <caption>{t('formats.caption')}</caption>
      <thead><tr><th scope="col" class="show-col"><span class="visually-hidden">{t('formats.showCol')}</span></th><th scope="col">{t('formats.th.format')}</th><th scope="col" class="size">{t('formats.th.size')}</th><th scope="col" class="crop">{t('formats.th.crop')}</th><th scope="col" class="area">{t('formats.th.area')}</th><th scope="col">{t('formats.th.note')}</th></tr></thead>
      {GROUPS.map(([g, label]) => (
        <tbody>
          <tr class="grp"><th scope="rowgroup" colspan="6">{label}</th></tr>
          {list.filter((f) => f.data.group === g).map((f) => {
            const e = f.data.entry ? entryById.get(f.data.entry.id) : undefined;
            const a = areaRatio(f.data.w, f.data.h);
            const crop = `${num(cropFactor(f.data.w, f.data.h), 2, 2)}×`;
            const areaTxt = a >= 10 ? `${num(a, 0)}×` : a >= 1.05 ? `${num(a, 1, 1)}×` : `${Math.round(a * 100)}%`;
            const size = `${num(f.data.w)} × ${num(f.data.h)}`;
            return (
              <tr data-id={f.id} class:list={{ on: f.id === DEFAULT }}>
                <td class="show-col">
                  <button type="button" class="show" data-id={f.id} aria-pressed={f.id === DEFAULT ? 'true' : 'false'} aria-label={t('formats.show', { name: f.data.name })} title={t('formats.showCol')}>
                    {(() => { const r = icon(f.data.w, f.data.h); return <svg viewBox="0 0 20 20" aria-hidden="true"><rect x={r.x} y={r.y} width={r.w} height={r.h} rx="1" /></svg>; })()}
                  </button>
                </td>
                <td class="name">{e ? <a href={url(`/entries/${e.id}/`, lang)}>{f.data.name}</a> : f.data.name}<span class="sub"><span>{size} mm</span> <span>{t('formats.sub.crop', { c: crop })}</span> <span>{t('formats.sub.area', { a: areaTxt })}</span></span></td>
                <td class="mono size">{size}</td>
                <td class="mono crop">{crop}</td>
                <td class="mono area">{areaTxt}</td>
                <td>{f.data.note}</td>
              </tr>
            );
          })}
        </tbody>
      ))}
    </table>
  </div>
  <script type="application/json" id="fmt-data" set:html={JSON.stringify(fmtData)} />
  <script>
    import { equivalent, areaRatio } from '../../lib/optics';
    import { useT, docLang, fmtNum } from '../../i18n';
    const LANG = docLang(), T = useT(LANG), num = (n: number, d = 1, min = 0) => fmtNum(LANG, n, d, min);
    type F = { id: string; name: string; w: number; h: number };
    const data = JSON.parse(document.getElementById('fmt-data')!.textContent!) as F[];
    const sel = document.getElementById('fmt') as HTMLSelectElement;
    const focal = document.getElementById('focal') as HTMLInputElement;
    const fnum = document.getElementById('fnum') as HTMLInputElement;
    const out = document.getElementById('out')!;
    const svg = document.getElementById('ov') as unknown as SVGSVGElement;
    const capText = document.getElementById('ov-text')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // zoom: animate the viewBox so the selected frame (or full frame, if larger) fills the drawing
    let cur = svg.viewBox.baseVal ? [svg.viewBox.baseVal.width, svg.viewBox.baseVal.height] : [41, 27.4];
    let raf = 0;
    function fit(f: F) {
      const to = [Math.max(f.w, 36) * 1.14, Math.max(f.h, 24) * 1.14];
      const from = cur.slice();
      cancelAnimationFrame(raf);
      const set = (w: number, h: number) => { cur = [w, h]; svg.setAttribute('viewBox', `${-w / 2} ${-h / 2} ${w} ${h}`); };
      if (reduce.matches) return set(to[0], to[1]);
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 520), e = 1 - Math.pow(1 - k, 3);
        // interpolate in log space so a 7× zoom feels even
        set(Math.exp(Math.log(from[0]) + (Math.log(to[0]) - Math.log(from[0])) * e), Math.exp(Math.log(from[1]) + (Math.log(to[1]) - Math.log(from[1])) * e));
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }
    function update(zoom = true) {
      const f = data.find((x) => x.id === sel.value)!;
      const fl = Number(focal.value) || 50, n = Number(fnum.value) || 1.8;
      const e = equivalent(fl, n, f.w, f.h);
      const a = areaRatio(f.w, f.h);
      out.innerHTML = '';
      const b = document.createElement('b');
      b.textContent = `${Math.round(e.focal)} mm f/${e.fNumber < 10 ? num(e.fNumber, 1, 1) : Math.round(e.fNumber)}`;
      const areaText = a >= 1.05 ? T('formats.areaMore', { a: num(a, a >= 10 ? 0 : 1, a >= 10 ? 0 : 1) }) : T('formats.areaLess', { p: Math.round(a * 100) });
      const isNormal = !focalTyped && fl === Math.round(Math.hypot(f.w, f.h));
      // the sentence has one bold part ({eq}): split around it so the rest stays text
      const [before, after] = T('formats.out', { fl: num(fl), n: num(n, 1), normal: isNormal ? T('formats.normal') : '', name: f.name, c: num(e.crop, 2, 2), area: areaText }).split('{eq}');
      out.append(before, b, after ?? '');
      capText.textContent = T('formats.against', { name: f.name, w: num(f.w), h: num(f.h) });
      svg.querySelectorAll<SVGRectElement>('.fmt').forEach((r) => r.classList.toggle('on', r.dataset.id === f.id));
      document.querySelectorAll<HTMLTableRowElement>('.fmt-table tr[data-id]').forEach((r) => r.classList.toggle('on', r.dataset.id === f.id));
      document.querySelectorAll<HTMLButtonElement>('.show').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === f.id)));
      if (zoom) fit(f);
    }
    // until the reader types a focal length, follow each format's normal lens (focal length ≈ frame diagonal)
    let focalTyped = false;
    const normal = () => { const f = data.find((x) => x.id === sel.value)!; return Math.round(Math.hypot(f.w, f.h)); };
    const pick = () => { if (!focalTyped) focal.value = String(normal()); update(); };
    sel.addEventListener('input', pick);
    focal.addEventListener('input', () => { focalTyped = true; update(false); });
    fnum.addEventListener('input', () => update(false));
    document.querySelectorAll<HTMLButtonElement>('.show').forEach((b) => b.addEventListener('click', () => {
      sel.value = b.dataset.id!;
      pick();
      document.querySelector('.overlay')!.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'nearest' });
    }));
    focal.value = String(normal());
    update(false);
  </script>
</Base>
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(260px, 1fr); gap: 16px; margin-top: 8px; }
  @media (max-width: 860px) { .layout { grid-template-columns: minmax(0, 1fr); } }
  .overlay { margin: 0; padding: 14px; display: grid; gap: 10px; align-content: start; }
  .overlay svg { width: 100%; aspect-ratio: 3 / 2; height: auto; display: block; background: var(--paper); border-radius: 8px; }
  .fmt { fill: none; stroke: var(--muted); stroke-width: 1; opacity: .55; }
  .fmt.on { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 2.4; opacity: 1; }
  .ff-ref { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-dasharray: 5 4; }
  figcaption { font-size: 13px; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 4px 14px; justify-content: space-between; }
  .key { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
  .key i { display: inline-block; width: 16px; height: 10px; border-radius: 2px; margin-left: 6px; }
  .k-ff { border: 1.6px dashed var(--ink); }
  .k-on { background: var(--accent-soft); border: 2px solid var(--accent); }
  .k-other { border: 1px solid var(--muted); opacity: .7; }
  .calc { padding: 4px 18px 18px; display: grid; gap: 6px; align-content: start; }
  .calc label { font-size: 13px; color: var(--ink-2); margin-top: 6px; }
  select, input { font: 400 15px/1.3 var(--font-body); color: var(--ink); background: var(--raised); border: 1px solid var(--rule); border-radius: 8px; padding: 8px 10px; min-width: 0; }
  .out { font-size: 14.5px; color: var(--ink-2); margin: 10px 0 0; }
  .out :global(b) { color: var(--accent); font-family: var(--font-mono); }
  .table-wrap { overflow-x: auto; margin-top: 22px; }
  .fmt-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .fmt-table caption { caption-side: top; text-align: left; font-size: 13px; color: var(--muted); padding: 0 12px 6px; }
  .fmt-table thead th { white-space: nowrap; text-align: left; font: 500 10.5px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: 12px; border-bottom: 1px solid var(--rule); }
  .fmt-table .grp th { text-align: left; font: 400 20px/1.2 var(--font-display); color: var(--ink); padding: 22px 12px 8px; border-bottom: 1px solid var(--rule); }
  .fmt-table td { padding: 10px 12px; border-bottom: 1px solid var(--rule-soft); color: var(--ink-2); vertical-align: top; }
  .fmt-table tr.on td { background: var(--accent-soft); }
  .fmt-table tr.on td:first-child { box-shadow: inset 3px 0 0 var(--accent); }
  .fmt-table .show-col { width: 1%; padding-right: 0; }
  .fmt-table td.show-col { padding-top: 6px; padding-bottom: 6px; }
  .fmt-table .name { white-space: nowrap; }
  .fmt-table .sub { display: none; }
  .fmt-table .mono { font-family: var(--font-mono); font-size: 13px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .show { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; color: var(--muted); background: var(--raised); border: 1px solid var(--rule); border-radius: 8px; cursor: pointer; }
  .show svg { width: 20px; height: 20px; }
  .show rect { fill: none; stroke: currentColor; stroke-width: 1.5; }
  .show:hover, .show:focus-visible { color: var(--accent); border-color: var(--accent); }
  .show[aria-pressed='true'] { color: var(--accent); border-color: var(--accent); }
  .show[aria-pressed='true'] rect { fill: var(--accent-soft); }
  @media (max-width: 700px) { .fmt-table thead th:last-child, .fmt-table td:last-child { display: none; } .fmt-table .grp th { padding-top: 16px; } .fmt-table td, .fmt-table thead th { padding-left: 8px; padding-right: 8px; } }
  /* phones: two lines per format, the name and then its size, crop and area, so nothing breaks mid-value */
  @media (max-width: 640px) {
    .fmt-table thead, .fmt-table .size, .fmt-table .crop, .fmt-table .area { display: none; }
    .fmt-table .name { white-space: normal; }
    .fmt-table .sub { display: flex; flex-wrap: wrap; gap: 0 6px; margin-top: 3px; font: 400 12px/1.4 var(--font-mono); color: var(--muted); font-variant-numeric: tabular-nums; }
    .fmt-table .sub > span { white-space: nowrap; }
  }
  @media (max-width: 360px) { .fmt-table .name { font-size: 13px; } }
</style>
