---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/content';
import { url } from '../../lib/url';
import { useT, langPaths, type Lang, fmtLicense } from '../../i18n';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const { milestones, entryById } = await content(lang);
const firstImg = milestones.findIndex((m) => m.data.image);
---
<Base title={t('landmarks.title')} description={t('landmarks.desc')}>
  <p class="eyebrow">{t('landmarks.eyebrow')}</p>
  <h1 class="page-title">{t('landmarks.title')}</h1>
  <p class="dek">{t('landmarks.dek')}</p>
  <ol class="lm">
    {milestones.map((m, i) => {
      const e = m.data.entry ? entryById.get(m.data.entry.id) : undefined;
      return (
        <li id={m.id}>
          {m.data.image && (
            <figure>
              <div class="mat"><Image src={m.data.image.src} alt={m.data.image.alt} widths={[400, 720, 1080]} sizes="(max-width: 820px) calc(100vw - 32px), 400px" loading={i === firstImg ? 'eager' : 'lazy'} fetchpriority={i === firstImg ? 'high' : undefined} /></div>
              <figcaption>{m.data.image.credit} · {fmtLicense(lang, m.data.image.license)} · <a href={m.data.image.source} rel="noopener">{t('common.source')} ↗</a></figcaption>
            </figure>
          )}
          <p class="when">{m.data.when}</p>
          <h2>{m.data.label}</h2>
          <p>{m.data.note}</p>
          {e && <p class="rel">{t('landmarks.related')} <a href={url(`/entries/${e.id}/`, lang)}>{e.data.title}</a></p>}
          <a class="tl" href={url('/', lang)}>{t('landmarks.back')}</a>
        </li>
      );
    })}
  </ol>
</Base>
<style>
  .lm { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 14px; }
  .lm li { border: 1px solid var(--rule); border-radius: 14px; background: var(--panel); padding: 18px; scroll-margin-top: 90px; }
  .lm li:target { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .when { font: 500 12px/1 var(--font-mono); color: var(--accent); margin: 0; }
  h2 { font: 400 23px/1.2 var(--font-display); margin: 8px 0; }
  p { color: var(--ink-2); font-size: 14.5px; margin: 0 0 8px; }
  .rel { font-size: 13.5px; }
  .tl { font: 500 11.5px/1 var(--font-mono); }
  figure { margin: -6px -6px 14px; }
  /* a print on a mat: never cropped, whatever its shape */
  .mat { aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 10px; border-radius: 9px; background: color-mix(in srgb, var(--ink) 8%, var(--paper)); }
  .mat :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; box-shadow: 0 1px 3px rgb(0 0 0 / .25); }
  figcaption { margin-top: 6px; }
  figcaption { font-size: 11.5px; line-height: 1.4; color: var(--muted); }
</style>
