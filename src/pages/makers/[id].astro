---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { content, WIKI, LINK_TEXT, type Maker } from '../../lib/content';
import { url } from '../../lib/url';
export async function getStaticPaths() {
  const { makers } = await content();
  return makers.map((maker) => ({ params: { id: maker.id }, props: { maker } }));
}
interface Props { maker: Maker }
const { maker } = Astro.props;
const d = maker.data;
const { Content } = await render(maker);
const { makerEntries, makerById, makerIncoming } = await content();
const list = makerEntries.get(maker.id) ?? [];
const lineage = [
  ...(makerIncoming.get(maker.id) ?? []).map((l) => ({ year: l.year, text: LINK_TEXT[l.kind].in, other: l.from, note: l.note })),
  ...d.links.map((l) => ({ year: l.year, text: LINK_TEXT[l.kind].out, other: makerById.get(l.to.id)!, note: l.note })),
].sort((a, b) => a.year - b.year);
---
<Base title={d.name} description={`${d.name}: ${d.country}, founded ${d.founded}. ${d.fate}`}>
  <p class="eyebrow"><a href={url('/makers/')}>Makers</a> · {d.country}</p>
  <h1 class="page-title">{d.name}</h1>
  <p class="when-big">Founded {d.founded}{d.ended ? ` · left photography ${d.ended}` : ''}</p>
  <div class="cols">
    <div class="prose"><Content /></div>
    <aside class="box">
      <p class="kicker">Fate</p><p>{d.fate}</p>
      {lineage.length > 0 && <><p class="kicker">Lineage</p><ul>{lineage.map((l) => <li><span class="mono">{l.year}</span> {l.text} <a href={url(`/makers/${l.other.id}/`)}>{l.other.data.name}</a>{l.note && <span class="note">{l.note}</span>}</li>)}</ul></>}
      <p class="kicker">On the timeline</p>
      {list.length ? <ul>{list.map((e) => <li><a href={url(`/entries/${e.id}/`)}>{e.data.label}</a> <span class="mono">{e.data.ds}</span></li>)}</ul> : <p>No entries yet.</p>}
      <p class="kicker">Sources</p>
      <ul>{d.refs.map((r) => <li><a href={r[1]} rel="noopener">{r[0]} ↗</a></li>)}<li><a href={WIKI + d.wiki} rel="noopener">Wikipedia ↗</a></li></ul>
    </aside>
  </div>
</Base>
<style>
  .eyebrow a { color: inherit; border: 0; }
  .when-big { font: 500 14px/1.4 var(--font-mono); color: var(--accent); margin: 0 0 18px; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 320px); gap: 40px; }
  @media (max-width: 860px) { .cols { grid-template-columns: minmax(0, 1fr); } }
  .prose :global(p) { font-size: 16.5px; }
  .box { border: 1px solid var(--rule); border-radius: 14px; background: var(--panel); padding: 16px 18px 18px; font-size: 14px; color: var(--ink-2); align-self: start; display: grid; gap: 6px; }
  .box :global(.kicker) { margin-top: 12px; }
  .box :global(.kicker:first-child) { margin-top: 0; }
  .box ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .box p { margin: 0; }
  .mono { font-size: 11.5px; color: var(--muted); font-family: var(--font-mono); }
  .note { display: block; font-size: 12.5px; color: var(--muted); }
</style>
