---
/**
 * One of a maker's highlight products: a public-domain photograph when there is one, else the site's camera
 * drawing (the model's own, or a typical one of its type, which the caption says), else a plain kind panel.
 */
import { Image } from 'astro:assets';
import { cameraDrawing } from '../lib/cameras';
import type { Maker } from '../lib/content';
import { url } from '../lib/url';
import { useT, pageLang, fmtLicense, type Key } from '../i18n';
type Highlight = Maker['data']['highlights'][number];
interface Props { h: Highlight }
const { h } = Astro.props;
const lang = pageLang(Astro);
const t = useT(lang);
const kind = t(`highlight.${h.kind}` as Key);
// the camera drawing: this model's own when the site has one, else a typical camera of its type (and the caption says so)
const draw = !h.image && h.cameraType ? cameraDrawing(h.entry?.id ?? h.id, h.cameraType, 1.25, 240) : null;
---
<article class="hl" id={`hl-${h.id}`}>
  {h.image ? (
    <figure class="pic">
      <div class="mat"><Image src={h.image.src} alt={h.image.alt} widths={[320, 480, 720]} sizes="(max-width: 640px) calc(100vw - 32px), 320px" loading="lazy" /></div>
      <figcaption>{h.image.credit} · {fmtLicense(lang, h.image.license)} · <a href={h.image.source} rel="noopener">{t('common.source')} ↗</a></figcaption>
    </figure>
  ) : draw && h.cameraType ? (
    <figure class="pic">
      <div class="mat art"><Fragment set:html={draw.svg} /></div>
      <figcaption>{draw.own ? t('highlight.drawing') : t('highlight.drawingTypical', { type: t(`camera.${h.cameraType}`) })}</figcaption>
    </figure>
  ) : (
    <div class="pic kindpanel" aria-hidden="true"><span>{kind}</span></div>
  )}
  <div class="txt">
    <p class="meta"><span class="mono">{h.year}</span> · {kind}</p>
    <h3>{h.name}</h3>
    <p class="note">{h.note}</p>
    {h.entry && <p class="go"><a href={url(`/entries/${h.entry.id}/`, lang)}>{t('highlight.onTimeline')}</a></p>}
  </div>
</article>
<style>
  .hl { display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--rule); border-radius: 14px; background: var(--panel); overflow: hidden; }
  .pic { margin: 0; }
  .mat { background: color-mix(in srgb, var(--ink) 6%, var(--panel)); display: grid; place-items: center; aspect-ratio: 4 / 3; }
  /* the photo is pinned inside the 4:3 mat, so a tall portrait shot cannot stretch its card */
  .mat:not(.art) { position: relative; }
  .mat :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .pic figcaption { font-size: 11.5px; color: var(--muted); padding: 6px 14px 0; line-height: 1.4; }
  .art { padding: 14px; box-sizing: border-box; }
  .art :global(svg) { max-width: 100%; max-height: 100%; width: auto; height: auto; }
  :global([data-theme="dark"]) .art { background: color-mix(in srgb, var(--ink) 30%, var(--panel)); }
  .kindpanel { display: grid; place-items: center; aspect-ratio: 4 / 3; background: color-mix(in srgb, var(--ink) 6%, var(--panel)); }
  .kindpanel span { font: 400 26px/1 var(--font-display); color: var(--ink-2); }
  .txt { padding: 12px 16px 16px; display: grid; align-content: start; gap: 6px; }
  .meta { margin: 0; font-size: 12px; color: var(--muted); }
  .mono { font-family: var(--font-mono); }
  h3 { margin: 0; font: 500 19px/1.2 var(--font-display); color: var(--ink); }
  .note { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-2); }
  .go { margin: 4px 0 0; font-size: 13.5px; }
</style>
