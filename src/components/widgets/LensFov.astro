---
/** Focal length, sensor size and angle of view, with the thin-lens equation for focusing. */
import { useT, pageLang } from '../../i18n';
const t = useT(pageLang(Astro));
const SENSORS = ([
  ['ff', 36, 24], ['apsc', 23.5, 15.6], ['m43', 17.3, 13], ['one', 13.2, 8.8], ['phone', 9.8, 7.4], ['mf', 56, 56],
] as const).map(([id, w, h]) => ({ id, name: t(`w.lf.${id}`), w, h }));
---
<figure class="wg" id="wg-lens" data-sensors={JSON.stringify(SENSORS)}>
  <div class="wg-head"><p class="kicker">{t('w.lf.kicker')}</p></div>
  <svg class="wide" viewBox="0 0 720 210" role="img" aria-labelledby="lf-sum">
    <defs>
      <clipPath id="lf-clip"><rect x="0" y="0" width="720" height="130" rx="8" /></clipPath>
    </defs>
    <!-- a 180° panorama, one degree = 4 px; the frame shows what the lens takes in -->
    <g clip-path="url(#lf-clip)">
      <rect x="0" y="0" width="720" height="130" fill="color-mix(in srgb, var(--f-optics) 14%, var(--panel))" />
      <path d="M0,96 L60,70 L120,88 L190,52 L250,80 L300,66 L360,40 L420,74 L470,60 L540,84 L600,58 L660,78 L720,64 V130 H0Z" fill="color-mix(in srgb, var(--ink) 18%, var(--panel))" />
      <rect x="0" y="100" width="720" height="30" fill="color-mix(in srgb, var(--f-colour) 30%, var(--panel))" />
      <g fill="var(--f-colour)"><circle cx="150" cy="96" r="10" /><circle cx="168" cy="99" r="7" /><circle cx="520" cy="95" r="11" /><circle cx="560" cy="99" r="7" /></g>
      <g><rect x="344" y="78" width="32" height="24" fill="var(--f-chem)" /><path d="M340,80 L360,64 L380,80Z" fill="var(--ink-2)" /><rect x="356" y="90" width="8" height="12" fill="var(--panel)" /></g>
      <circle cx="610" cy="24" r="9" fill="var(--band)" />
      <g id="lf-shade"></g>
    </g>
    <rect id="lf-frame" fill="none" stroke="var(--accent)" stroke-width="2.5" rx="2" />
    <g id="lf-ticks"></g>
    <!-- top view: lens and sensor, the cone of view -->
    <g id="lf-top"></g>
  </svg>
  <div class="wg-controls">
    <div class="wg-ctl"><label for="lf-f">{t('w.lf.f')} <output id="lf-f-out" for="lf-f"></output></label><input id="lf-f" type="range" min="0" max="1000" /></div>
    <div class="wg-ctl"><label for="lf-s">{t('w.lf.s')}</label><select id="lf-s">{SENSORS.map((s) => <option value={s.id}>{s.name}</option>)}</select></div>
    <div class="wg-ctl"><label for="lf-u">{t('w.lf.u')} <output id="lf-u-out" for="lf-u"></output></label><input id="lf-u" type="range" min="0" max="1000" /></div>
  </div>
  <dl class="wg-read">
    <div><dt>{t('w.lf.h')}</dt><dd id="lf-h"></dd></div>
    <div><dt>{t('w.lf.d')}</dt><dd id="lf-d"></dd></div>
    <div><dt>{t('w.lf.eq')}</dt><dd id="lf-eq"></dd></div>
    <div><dt>{t('w.lf.ext')}</dt><dd id="lf-ext"></dd></div>
  </dl>
  <p class="wg-sum" id="lf-sum" aria-live="polite"></p>
</figure>

<script>
  import { angleOfView, cropFactor, thinLens } from '../../lib/optics';
  import { $, logRange, fmtMm as mm } from '../../scripts/widgets/util';
  import { useT, docLang, fmtNum } from '../../i18n';
  const LANG = docLang(), T = useT(LANG), fmtMm = (x: number) => mm(x, LANG);
  const root = document.getElementById('wg-lens')!;
  const SENSORS = JSON.parse(root.dataset.sensors!) as { id: string; name: string; w: number; h: number }[];
  const fIn = $<HTMLInputElement>(root, '#lf-f'), uIn = $<HTMLInputElement>(root, '#lf-u'), sIn = $<HTMLSelectElement>(root, '#lf-s');
  const f = logRange(fIn, 8, 800), u = logRange(uIn, 250, 100000);
  const set = (id: string, t: string) => { $<HTMLElement>(root, id).textContent = t; };
  const deg = (x: number) => `${x < 10 ? fmtNum(LANG, x, 1, 1) : Math.round(x)}°`;

  function draw() {
    const fl = f.get(), s = SENSORS.find((x) => x.id === sIn.value)!, ud = u.get();
    const h = angleOfView(s.w, fl), v = angleOfView(s.h, fl), dg = angleOfView(Math.hypot(s.w, s.h), fl);
    const c = cropFactor(s.w, s.h), tl = thinLens(fl, ud);
    set('#lf-f-out', `${Math.round(fl)} mm`); set('#lf-u-out', fmtMm(ud));
    set('#lf-h', deg(h)); set('#lf-d', deg(dg)); set('#lf-eq', `${Math.round(fl * c)} mm`); set('#lf-ext', fmtMm(tl.v - fl));
    // frame on the panorama: 4 px per degree horizontally; vertical extent on the same scale, centred on the horizon
    const fw = Math.min(720, h * 4), fh = Math.min(130, v * 4), fx = 360 - fw / 2, fy = Math.max(0, 70 - fh / 2);
    const fr = $<SVGRectElement>(root, '#lf-frame');
    fr.setAttribute('x', String(fx)); fr.setAttribute('y', String(fy)); fr.setAttribute('width', String(fw)); fr.setAttribute('height', String(Math.min(fh, 130 - fy)));
    $<SVGGElement>(root, '#lf-shade').innerHTML = `<path fill="var(--panel)" opacity=".62" fill-rule="evenodd" d="M0,0H720V130H0Z M${fx},${fy}h${fw}v${Math.min(fh, 130 - fy)}h${-fw}Z"/>`;
    $<SVGGElement>(root, '#lf-ticks').innerHTML = [-90, -60, -30, 0, 30, 60, 90].map((a) => `<text x="${360 + a * 4}" y="146" text-anchor="${a === -90 ? 'start' : a === 90 ? 'end' : 'middle'}">${a === 0 ? '0°' : `${a > 0 ? '+' : '−'}${Math.abs(a)}°`}</text>`).join('');
    // top view: lens at (360, 190), cone opening upward with the horizontal angle
    const half = (Math.min(h, 179) / 2) * (Math.PI / 180), L = 34;
    const x1 = 360 - Math.sin(half) * L * 1.6, x2 = 360 + Math.sin(half) * L * 1.6, y = 190 - Math.cos(half) * L;
    $<SVGGElement>(root, '#lf-top').innerHTML = `<path d="M360,190 L${x1},${y} M360,190 L${x2},${y}" stroke="var(--accent)" stroke-width="1.5" fill="none"/>`
      + `<path d="M${x1},${y} Q360,${y - 10} ${x2},${y}" stroke="var(--accent)" stroke-dasharray="2 3" fill="none"/>`
      + `<rect x="350" y="190" width="20" height="12" rx="2" fill="var(--ink-2)"/><text x="380" y="200">${T('w.lf.top')}</text>`;
    set('#lf-sum', T('w.lf.sum', { f: Math.round(fl), sensor: s.name.split(',')[0], h: deg(h), d: deg(dg), eq: Math.round(fl * c), u: fmtMm(ud), ext: fmtMm(tl.v - fl) }));
  }
  for (const el of [fIn, uIn, sIn]) el.addEventListener('input', draw);
  f.set(50); u.set(3000); draw();
</script>
