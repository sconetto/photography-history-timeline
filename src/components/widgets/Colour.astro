---
/** Three-colour mixing (light adds, dyes subtract) and colour temperature with white balance. */
---
<figure class="wg" id="wg-col">
  <div class="wg-head"><p class="kicker">Try it: mixing colour, and the colour of light</p></div>
  <div class="wg-stage">
    <svg viewBox="0 0 300 250" role="img" aria-labelledby="col-sum">
      <rect id="col-bg" width="300" height="220" rx="10" />
      <g id="col-mix"></g>
      <text id="col-cap" class="lbl" x="150" y="243" text-anchor="middle"></text>
    </svg>
    <svg viewBox="0 0 300 250" role="img" aria-labelledby="col-wb-sum">
      <g id="col-wb"></g>
    </svg>
  </div>
  <div class="wg-controls">
    <div class="wg-ctl"><label for="col-mode">Mixing</label>
      <select id="col-mode"><option value="add">Light: red, green, blue (additive)</option><option value="sub">Dyes: cyan, magenta, yellow (subtractive)</option></select></div>
    <div class="wg-ctl"><label for="col-a"><span id="col-a-l">Red</span> <output id="col-a-out" for="col-a"></output></label><input id="col-a" type="range" min="0" max="100" value="100" /></div>
    <div class="wg-ctl"><label for="col-b"><span id="col-b-l">Green</span> <output id="col-b-out" for="col-b"></output></label><input id="col-b" type="range" min="0" max="100" value="100" /></div>
    <div class="wg-ctl"><label for="col-c"><span id="col-c-l">Blue</span> <output id="col-c-out" for="col-c"></output></label><input id="col-c" type="range" min="0" max="100" value="100" /></div>
  </div>
  <div class="wg-controls">
    <div class="wg-ctl"><label for="col-k">Light source <output id="col-k-out" for="col-k"></output></label><input id="col-k" type="range" min="1800" max="10000" step="100" value="3200" /></div>
    <div class="wg-ctl"><label for="col-wbk">White balance set to <output id="col-wbk-out" for="col-wbk"></output></label><input id="col-wbk" type="range" min="1800" max="10000" step="100" value="5500" /></div>
    <div class="wg-ctl"><button type="button" class="chip" id="col-match">Match the light (auto white balance)</button></div>
  </div>
  <p class="wg-sum" id="col-sum" aria-live="polite"></p>
  <p class="wg-sum" id="col-wb-sum" aria-live="polite"></p>
</figure>

<script>
  import { kelvinRgb } from '../../lib/optics';
  import { $ } from '../../scripts/widgets/util';
  const root = document.getElementById('wg-col')!;
  const mode = $<HTMLSelectElement>(root, '#col-mode');
  const ins = ['#col-a', '#col-b', '#col-c'].map((s) => $<HTMLInputElement>(root, s));
  const kIn = $<HTMLInputElement>(root, '#col-k'), wIn = $<HTMLInputElement>(root, '#col-wbk');
  const set = (id: string, t: string) => { $<HTMLElement>(root, id).textContent = t; };
  const hex = (c: number[]) => '#' + c.map((v) => Math.round(Math.min(255, Math.max(0, v))).toString(16).padStart(2, '0')).join('');
  const lin = (v: number) => (v / 255) ** 2.2, enc = (v: number) => 255 * Math.min(1, Math.max(0, v)) ** (1 / 2.2);

  function name(c: number[]) {
    const [r, g, b] = c.map((v) => v > 170 ? 2 : v > 70 ? 1 : 0);
    const key = `${r}${g}${b}`;
    const N: Record<string, string> = { '222': 'white', '000': 'black', '200': 'red', '020': 'green', '002': 'blue', '220': 'yellow', '022': 'cyan', '202': 'magenta', '111': 'grey', '210': 'orange', '201': 'pink', '120': 'yellow-green', '021': 'teal', '012': 'azure', '102': 'violet' };
    return N[key] ?? 'a mixed colour';
  }

  function mix() {
    const add = mode.value === 'add', v = ins.map((i) => Number(i.value) / 100);
    const labels = add ? ['Red', 'Green', 'Blue'] : ['Cyan', 'Magenta', 'Yellow'];
    labels.forEach((l, i) => { set(`#col-${'abc'[i]}-l`, `${l} ${add ? 'light' : 'dye'}`); set(`#col-${'abc'[i]}-out`, `${Math.round(v[i] * 100)}%`); });
    $<SVGRectElement>(root, '#col-bg').setAttribute('fill', add ? '#000' : '#fff');
    // three overlapping discs: screen (adds light) or multiply (each dye removes one primary)
    const pos = [[150, 82], [116, 140], [184, 140]];
    const fills = add
      ? v.map((x, i) => hex([0, 1, 2].map((j) => (j === i ? enc(x) : 0))))
      : v.map((x, i) => hex([0, 1, 2].map((j) => (j === i ? enc(1 - x) : 255))));
    const blend = add ? 'screen' : 'multiply';
    // the centre, where all three overlap
    const centre = add ? v.map(enc) : v.map((x) => enc(1 - x));
    $<SVGGElement>(root, '#col-mix').innerHTML = `<g style="isolation:isolate">${pos.map(([x, y], i) => `<circle cx="${x}" cy="${y}" r="58" fill="${fills[i]}" style="mix-blend-mode:${blend}"/>`).join('')}</g>`;
    set('#col-cap', `centre: ${name(centre)} ${hex(centre)}`);
    set('#col-sum', add
      ? `Light adds: red ${Math.round(v[0] * 100)}%, green ${Math.round(v[1] * 100)}% and blue ${Math.round(v[2] * 100)}% make ${name(centre)} where all three overlap. Screens and sensors mix colour this way.`
      : `Dyes subtract from white light: cyan ${Math.round(v[0] * 100)}%, magenta ${Math.round(v[1] * 100)}% and yellow ${Math.round(v[2] * 100)}% leave ${name(centre)} where all three overlap. Colour film and prints mix colour this way.`);
  }

  // a small still life: reflectances in linear light
  const OBJ: [string, number[], string][] = [
    ['paper', [0.85, 0.85, 0.85], '<rect x="40" y="40" width="220" height="150" rx="4"/>'],
    ['apple', [0.55, 0.05, 0.035], '<circle cx="112" cy="128" r="34"/>'],
    ['leaf', [0.07, 0.28, 0.05], '<path d="M112,94 q22,-26 40,-14 q-18,18 -40,14Z"/>'],
    ['mug', [0.06, 0.16, 0.5], '<path d="M170,96 h56 v66 a8,8 0 0 1 -8,8 h-40 a8,8 0 0 1 -8,-8Z"/>'],
  ];
  function wb() {
    const K = Number(kIn.value), W = Number(wIn.value);
    set('#col-k-out', `${K} K`); set('#col-wbk-out', `${W} K`);
    const L = kelvinRgb(K).map(lin), B = kelvinRgb(W).map(lin);
    const gain = [0, 1, 2].map((i) => L[i] / B[i]), norm = 1 / Math.max(...gain);
    const eye = (r: number[]) => hex(r.map((x) => enc(x * 1.08))); // the eye adapts: neutral under any light
    const fixed = (r: number[]) => hex(r.map((x, i) => enc(x * gain[i] * norm * 1.08)));
    const scene = (f: (r: number[]) => string, dx: number, dy: number, s: number) => `<g transform="translate(${dx},${dy}) scale(${s})">${OBJ.map(([, r, d]) => d.replace(/^<(\w+)/, `<$1 fill="${f(r)}"`)).join('')}</g>`;
    $<SVGGElement>(root, '#col-wb').innerHTML =
      `<text class="lbl" x="4" y="14">To the eye</text><text class="lbl" x="154" y="14">To the camera</text>`
      + `<rect x="0" y="22" width="146" height="110" rx="8" fill="#000"/>${scene(eye, -20, 4, 0.6)}`
      + `<rect x="154" y="22" width="146" height="110" rx="8" fill="#000"/>${scene(fixed, 134, 4, 0.6)}`
      + `<text x="73" y="148" text-anchor="middle">adapted to ${K} K</text><text x="227" y="148" text-anchor="middle">balanced for ${W} K</text>`
      + `<text class="lbl" x="4" y="180">Colour of the light</text>`
      + Array.from({ length: 30 }, (_, i) => { const k = 1800 + (i * 8200) / 29; return `<rect x="${4 + i * 9.73}" y="190" width="10.3" height="18" fill="${hex(kelvinRgb(k))}"/>`; }).join('')
      + `<path d="M${4 + ((K - 1800) / 8200) * 292},214 l-6,10 h12Z" class="fill-acc"/><path d="M${4 + ((W - 1800) / 8200) * 292},186 l-6,-10 h12Z" fill="var(--ink-2)"/>`
      + `<text x="4" y="240">1800 K</text><text x="${4 + (3700 / 8200) * 292}" y="240" text-anchor="middle">5500 K</text><text x="296" y="240" text-anchor="end">10 000 K</text>`;
    const off = Math.log2(W / K);
    set('#col-wb-sum', Math.abs(off) < 0.08
      ? `White balance matches the ${K} K light, so the paper records as neutral white.`
      : `The camera is balanced for ${W} K but the light is ${K} K, so the picture comes out too ${off > 0 ? 'orange' : 'blue'}. Our eyes adapt and see white paper; film and sensors do not.`);
  }
  for (const el of [mode, ...ins]) el.addEventListener('input', mix);
  for (const el of [kIn, wIn]) el.addEventListener('input', wb);
  $<HTMLButtonElement>(root, '#col-match').addEventListener('click', () => { wIn.value = kIn.value; wb(); });
  mix(); wb();
</script>
