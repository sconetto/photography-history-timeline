---
/** Pinhole camera: hole size and box depth against brightness and the two kinds of blur (geometric, diffraction). */
---
<figure class="wg" id="wg-pinhole">
  <div class="wg-head"><p class="kicker">Try it: a pinhole camera</p></div>
  <div class="wg-stage">
    <svg viewBox="0 0 420 220" role="img" aria-labelledby="ph-sum">
      <defs><filter id="ph-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur id="ph-gb" stdDeviation="1" /></filter></defs>
      <!-- the scene: a tree in sunlight -->
      <g id="ph-scene">
        <line class="ln-soft" x1="10" y1="170" x2="120" y2="170" />
        <circle cx="60" cy="72" r="26" fill="var(--f-colour)" />
        <rect x="55" y="96" width="10" height="74" fill="var(--f-chem)" />
        <circle cx="104" cy="34" r="10" fill="var(--band)" stroke="var(--rule)" />
      </g>
      <!-- the box: front wall with the hole, back wall as the screen -->
      <rect id="ph-box" class="fill-paper" x="200" y="40" width="160" height="140" stroke="var(--ink-2)" />
      <rect id="ph-screen" x="358" y="42" width="4" height="136" fill="var(--rule)" />
      <g id="ph-rays"></g>
      <g id="ph-img" filter="url(#ph-blur)"></g>
      <text x="200" y="32" text-anchor="middle">hole</text>
      <text x="300" y="200" text-anchor="middle" id="ph-depth-l"></text>
    </svg>
    <svg viewBox="0 0 460 250" role="img" aria-label="Blur against hole size: geometric blur rises with the hole, diffraction blur falls, and the sharpest hole is where they balance.">
      <g id="ph-chart"></g>
    </svg>
  </div>
  <div class="wg-controls">
    <div class="wg-ctl"><label for="ph-d">Hole diameter <output id="ph-d-out" for="ph-d"></output></label><input id="ph-d" type="range" min="0" max="1000" value="500" /></div>
    <div class="wg-ctl"><label for="ph-f">Box depth (hole to screen) <output id="ph-f-out" for="ph-f"></output></label><input id="ph-f" type="range" min="20" max="300" step="5" value="100" /></div>
    <div class="wg-ctl"><button type="button" class="chip" id="ph-best">Use the sharpest hole</button></div>
  </div>
  <dl class="wg-read">
    <div><dt>f-number (depth ÷ hole)</dt><dd id="ph-n"></dd></div>
    <div><dt>Blur from the hole’s size</dt><dd id="ph-geo"></dd></div>
    <div><dt>Blur from diffraction</dt><dd id="ph-dif"></dd></div>
    <div><dt>Sharpest hole for this depth</dt><dd id="ph-opt"></dd></div>
  </dl>
  <p class="wg-sum" id="ph-sum" aria-live="polite"></p>
</figure>

<script>
  import { pinholeBlur, rayleighPinhole } from '../../lib/optics';
  import { $, logRange, fmtMm, fmtN } from '../../scripts/widgets/util';
  const root = document.getElementById('wg-pinhole')!;
  const dIn = $<HTMLInputElement>(root, '#ph-d'), fIn = $<HTMLInputElement>(root, '#ph-f');
  const d = logRange(dIn, 0.05, 3);
  const set = (id: string, t: string) => { $<HTMLElement>(root, id).textContent = t; };
  const NS = 'http://www.w3.org/2000/svg';
  const path = (g: Element, dAttr: string, attrs: Record<string, string>) => { const p = document.createElementNS(NS, 'path'); p.setAttribute('d', dAttr); for (const k in attrs) p.setAttribute(k, attrs[k]); g.append(p); };

  function draw() {
    const dm = d.get(), f = Number(fIn.value);
    const b = pinholeBlur(dm, f), best = rayleighPinhole(f), N = f / dm;
    set('#ph-d-out', fmtMm(dm)); set('#ph-f-out', `${f} mm`);
    set('#ph-n', fmtN(N)); set('#ph-geo', fmtMm(b.geometric)); set('#ph-dif', fmtMm(b.diffraction)); set('#ph-opt', fmtMm(best));
    // diagram: box depth drawn to scale (screen at 200 + f·0.5), hole size exaggerated
    const x0 = 200, xs = x0 + Math.max(40, f * 0.5), cy = 110, gap = Math.min(30, 2 + dm * 9);
    $<SVGRectElement>(root, '#ph-box').setAttribute('width', String(xs - x0));
    $<SVGRectElement>(root, '#ph-screen').setAttribute('x', String(xs - 2));
    const dl = $<SVGTextElement>(root, '#ph-depth-l'); dl.setAttribute('x', String((x0 + xs) / 2)); dl.textContent = `${f} mm`;
    const rays = $<SVGGElement>(root, '#ph-rays'); rays.innerHTML = '';
    // the front wall with a gap for the hole
    path(rays, `M${x0},${cy - gap / 2} V${cy + gap / 2}`, { stroke: 'var(--panel)', 'stroke-width': '3' });
    // rays from the treetop (y 46) and trunk foot (y 170) through the hole edges, landing upside down
    const k = (xs - x0) / (x0 - 60);
    for (const [y, col] of [[46, 'var(--f-colour)'], [170, 'var(--f-chem)']] as const) {
      for (const h of [-gap / 2, gap / 2]) {
        const yy = cy + h, ye = yy + (yy - y) * k;
        path(rays, `M60,${y} L${x0},${yy} L${xs},${ye}`, { stroke: col, 'stroke-width': '1', opacity: '.55', fill: 'none' });
      }
    }
    // the image: the scene flipped, scaled by depth, blurred by the total blur, dimmer as the f-number grows
    const img = $<SVGGElement>(root, '#ph-img');
    const s = k, tx = xs - 3;
    img.innerHTML = `<rect x="${tx - 3}" y="${cy + (cy - 170) * s}" width="4" height="${74 * s}" fill="var(--f-chem)"/>`
      + `<ellipse cx="${tx - 4}" cy="${cy + (cy - 72) * s}" rx="6" ry="${26 * s}" fill="var(--f-colour)"/>`;
    const brightness = Math.min(1, Math.max(0.12, (100 / N) ** 0.6));
    img.setAttribute('opacity', brightness.toFixed(2));
    $<SVGFEGaussianBlurElement>(root, '#ph-gb').setAttribute('stdDeviation', String(Math.min(9, 0.6 + b.total * 2.4)));

    // chart: blur against hole size on log axes
    const g = $<SVGGElement>(root, '#ph-chart'); g.innerHTML = '';
    const L = 40, R = 445, T = 18, B = 200;
    const lx = (x: number) => L + ((Math.log(x) - Math.log(0.05)) / (Math.log(3) - Math.log(0.05))) * (R - L);
    const ymax = 3, ly = (y: number) => B - (Math.min(y, ymax) / ymax) * (B - T);
    let gs = '', gd = '', gt = '';
    for (let i = 0; i <= 80; i++) {
      const x = 0.05 * Math.pow(60, i / 80), bb = pinholeBlur(x, f), c = i ? 'L' : 'M';
      gs += `${c}${lx(x).toFixed(1)},${ly(bb.geometric).toFixed(1)}`; gd += `${c}${lx(x).toFixed(1)},${ly(bb.diffraction).toFixed(1)}`; gt += `${c}${lx(x).toFixed(1)},${ly(bb.total).toFixed(1)}`;
    }
    g.innerHTML = `<line class="ln-soft" x1="${L}" y1="${B}" x2="${R}" y2="${B}"/><line class="ln-soft" x1="${L}" y1="${T}" x2="${L}" y2="${B}"/>`
      + [0.1, 0.3, 1, 3].map((x) => `<text x="${lx(x)}" y="${B + 14}" text-anchor="middle">${x} mm</text>`).join('')
      + [0, 1, 2, 3].map((y) => `<text x="${L - 6}" y="${ly(y) + 4}" text-anchor="end">${y}</text>`).join('')
      + `<text x="${L}" y="${T - 4}">blur, mm</text><text x="${R}" y="${B + 32}" text-anchor="end">hole diameter →</text>`
      + `<path d="${gs}" stroke="var(--f-chem)" stroke-dasharray="4 3" fill="none"/><path d="${gd}" stroke="var(--f-optics)" stroke-dasharray="1.5 3" stroke-linecap="round" fill="none"/>`
      + `<path d="${gt}" stroke="var(--ink)" stroke-width="2" fill="none"/>`
      + `<line x1="${lx(best)}" x2="${lx(best)}" y1="${T}" y2="${B}" stroke="var(--muted)" stroke-dasharray="2 3"/>`
      + `<circle cx="${lx(dm)}" cy="${ly(b.total)}" r="5" fill="var(--accent)" stroke="var(--panel)" stroke-width="2"/>`
      + `<text x="${lx(0.06)}" y="${ly(2.7)}" fill="var(--f-optics)">diffraction</text><text x="${lx(2.2)}" y="${ly(2.3)}" text-anchor="end" fill="var(--f-chem)">hole size</text>`;
    const verdict = dm < best * 0.7 ? 'too small: diffraction spreads the light' : dm > best * 1.4 ? 'too big: each point becomes a wide disc' : 'close to the sharpest size';
    set('#ph-sum', `A ${fmtMm(dm)} hole in a ${f} mm box works at ${fmtN(N)}. Total blur is about ${fmtMm(b.total)}; the hole is ${verdict}.`);
  }
  dIn.addEventListener('input', draw); fIn.addEventListener('input', draw);
  $<HTMLButtonElement>(root, '#ph-best').addEventListener('click', () => { d.set(rayleighPinhole(Number(fIn.value))); draw(); });
  d.set(1.2); draw();
</script>
