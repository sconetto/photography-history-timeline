---
/**
 * A maker's logo on a light plate (so dark logos stay visible on the night theme), or, when no public-domain
 * logo exists, a typographic name plate in the site's own type. Logos are SVG or raster files from Wikimedia
 * Commons, always rendered with <img>, never inlined, so nothing inside an SVG can run.
 * `decorative` hides it from assistive tech where the maker's name is already next to it (lists, the page title).
 */
import { Image } from 'astro:assets';
import type { Maker } from '../lib/content';
import { useT, pageLang, fmtEra } from '../i18n';
interface Props { maker: Maker; size?: 'lg' | 'sm'; decorative?: boolean }
const { maker, size = 'lg', decorative = false } = Astro.props;
const lang = pageLang(Astro);
const t = useT(lang);
const { name, logo } = maker.data;
const short = name.replace(/\s*\(.*\)$/, '');
// the small plate is a narrow list column: drop a leading article so long names wrap onto two lines
const label = size === 'sm' ? short.replace(/^The\s+/i, '') : short;

/*
 * Every plate has the same size, and every logo inside it gets roughly the same visual weight: the logo is
 * sized to a common area (AREA) rather than a common height, so a wide wordmark and a square emblem look
 * alike in size, then capped to the plate's content box. Logo files are trimmed to their artwork, so the
 * box measures the mark itself, not empty margins.
 */
const BOX = { lg: { w: 232, h: 72, area: 8800 }, sm: { w: 88, h: 30, area: 1530 } } as const;
function fit(ratio: number, box: { w: number; h: number; area: number }) {
  let h = Math.sqrt(box.area / ratio), w = h * ratio;
  if (w > box.w) { w = box.w; h = w / ratio; }
  if (h > box.h) { h = box.h; w = h * ratio; }
  return { w: Math.round(w), h: Math.round(h) };
}
const dims = logo ? fit(logo.src.width / logo.src.height, BOX[size]) : null;
---
{logo ? (
  <span class:list={['plate', size]} title={t('maker.logo', { name: short, era: fmtEra(lang, logo.era) })}>
    <Image src={logo.src} alt={decorative ? '' : logo.alt} width={dims!.w} height={dims!.h} densities={[1, 2]} loading={size === 'lg' ? 'eager' : 'lazy'} style={`width:${dims!.w}px;height:${dims!.h}px`} />
  </span>
) : (
  <span class:list={['plate', 'nameplate', size]} aria-hidden="true">{label}</span>
)}
<style>
  /* a print-white plate in every palette and mode: logos are designed for light backgrounds.
     All plates of a size are identical, with or without a logo, so a row or list of makers lines up. */
  .plate { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; background: #fbfaf6; border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); border-radius: 12px; flex: none; overflow: hidden; }
  .plate.lg { width: 272px; height: 104px; padding: 16px 20px; }
  .plate.sm { width: 104px; height: 44px; padding: 7px 8px; border-radius: 8px; }
  /* the logo's size is set per logo above; this only keeps it from ever spilling out of a narrow plate */
  .plate :global(img) { display: block; flex: none; max-width: 100%; max-height: 100%; object-fit: contain; }
  .nameplate { color: #1d1b17; font: 400 24px/1.1 var(--font-display); letter-spacing: .02em; text-align: center; overflow-wrap: anywhere; }
  .nameplate.sm { font-size: 12.5px; line-height: 1.05; letter-spacing: .02em; }
</style>
