---
import PalettePicker from './PalettePicker.astro';
import LangSwitch from './LangSwitch.astro';
import { NAV as nav } from '../lib/nav';
import { url } from '../lib/url';
import { useT, pageLang, stripLang } from '../i18n';
const lang = pageLang(Astro);
const t = useT(lang);
const path = stripLang(Astro.url.pathname);
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-head">
  <div class="wrap row">
    <a class="brand" href={url('/', lang)} aria-label={t('site.home')}>
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="9.5" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="11" cy="11" r="3.2" fill="currentColor"/></svg>
      <span>Photography <em>Through</em> Time</span>
    </a>
    <nav id="site-nav" aria-label={t('nav.sections')}>
      <ul>
        {nav.map(([href, key]) => <li><a href={url(href, lang)} aria-current={active(href) ? 'page' : undefined}>{t(key)}</a></li>)}
        <li class="nav-langs"><LangSwitch /></li>
        <li class="nav-search"><a href={url('/search/', lang)} aria-current={active('/search/') ? 'page' : undefined}>{t('nav.search')}</a></li>
      </ul>
    </nav>
    <div class="tools">
      <a class="search-link" href={url('/search/', lang)} aria-keyshortcuts="/" title={t('header.searchTitle')}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="10.8" y1="10.8" x2="14.5" y2="14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span class="lbl">{t('nav.search')}</span>
      </a>
      <LangSwitch class="langs-tools" />
      <PalettePicker />
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path class="l1" d="M2 4h12"/><path class="l2" d="M2 8h12"/><path class="l3" d="M2 12h12"/></svg>
        <span class="lbl">{t('header.menu')}</span>
      </button>
    </div>
  </div>
</header>
<script>
  const head = document.querySelector<HTMLElement>('.site-head')!;
  const btn = head.querySelector<HTMLButtonElement>('.menu-btn')!;
  const set = (open: boolean) => { head.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); };
  btn.addEventListener('click', () => set(!head.classList.contains('open')));
  document.addEventListener('click', (e) => { if (head.classList.contains('open') && !head.querySelector('nav')!.contains(e.target as Node) && !btn.contains(e.target as Node)) set(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && head.classList.contains('open')) { set(false); btn.focus(); } });
  // "/" opens search from anywhere (unless typing in a field)
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable]')) return;
    e.preventDefault();
    const field = document.querySelector<HTMLInputElement>('#search input');
    if (field) field.focus(); else location.href = document.querySelector<HTMLAnchorElement>('.search-link')!.href;
  });
  // leaving the collapsed layout (rotate, resize) resets the menu
  matchMedia('(min-width: 1141px)').addEventListener('change', (m) => { if (m.matches) set(false); });
</script>
<style>
  .site-head { border-bottom: 1px solid var(--rule-soft); background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(6px); position: sticky; top: 0; z-index: 30; }
  .row { display: flex; align-items: center; gap: 8px 18px; padding-block: 10px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); border: 0; font: 400 19px/1 var(--font-display); white-space: nowrap; flex: none; }
  .brand em { color: var(--accent); }
  .brand svg { color: var(--accent); flex: none; }
  nav { flex: 1 1 auto; min-width: 0; }
  nav ul { list-style: none; display: flex; gap: 2px 2px; margin: 0; padding: 0; }
  nav a { display: inline-block; padding: 6px 9px; border-radius: 999px; border: 0; color: var(--ink-2); font-size: 13.5px; white-space: nowrap; }
  nav a:hover { color: var(--ink); background: var(--rule-soft); }
  nav a[aria-current="page"] { color: var(--ink); background: var(--band); }
  .nav-search, .nav-langs { display: none; }
  .tools { display: flex; align-items: center; gap: 8px; margin-left: auto; flex: none; }
  .search-link, .menu-btn { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); border: 1px solid var(--rule); border-radius: 999px; padding: 6px 11px; font: inherit; font-size: 13px; background: none; cursor: pointer; white-space: nowrap; }
  .search-link:hover, .menu-btn:hover, .menu-btn[aria-expanded="true"] { color: var(--ink); border-color: var(--muted); }
  .menu-btn { display: none; }
  .menu-btn svg path { stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; transition: transform .2s ease, opacity .2s ease; transform-origin: 8px 8px; }
  .menu-btn[aria-expanded="true"] .l1 { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .l2 { opacity: 0; }
  .menu-btn[aria-expanded="true"] .l3 { transform: translateY(-4px) rotate(-45deg); }

  /* laptops: tools go icon-only so brand, nav and tools share one row */
  @media (max-width: 1400px) {
    .search-link { padding: 7px 9px; }
    .search-link .lbl, .tools :global(.cur-name) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  /* tablets and phones: the nav folds into a Menu button (only when JS can open it again) */
  @media (max-width: 1140px) {
    :global(html.js) .menu-btn { display: inline-flex; }
    :global(html.js) nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--raised); border-bottom: 1px solid var(--rule); box-shadow: 0 16px 32px var(--shadow); }
    :global(html.js) .site-head.open nav { display: block; }
    :global(html.js) nav ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 4px; max-width: 1320px; margin: 0 auto; padding: 12px clamp(16px, 3vw, 40px) 16px; }
    :global(html.js) nav a { display: block; padding: 11px 14px; border-radius: 10px; font-size: 15px; }
    /* without JS the nav stays visible as a row of its own that scrolls sideways */
    :global(html:not(.js)) .row { flex-wrap: wrap; }
    :global(html:not(.js)) nav { order: 3; flex-basis: 100%; overflow-x: auto; }
  }
  @media (max-width: 560px) {
    .brand { font-size: 17px; gap: 7px; }
    :global(html.js) .search-link { display: none; }
    :global(html.js) .nav-search { display: block; }
    /* phones: the language switcher moves from the tools into the nav (the menu, or the no-JS row) */
    .tools :global(.langs-tools) { display: none; }
    .nav-langs { display: block; }
    :global(html.js) .nav-langs { padding: 6px 14px; }
    .menu-btn { padding: 7px 9px; }
    .menu-btn .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (max-width: 420px) {
    .row { gap: 8px 10px; }
    .brand { font-size: 15.5px; }
    .tools { gap: 6px; }
    .tools :global(summary > svg) { display: none; }
  }
  @media (max-width: 360px) {
    .brand { font-size: 14.5px; }
    .brand svg { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .menu-btn svg path { transition: none; } }
</style>
