---
import ThemeSwitch from './ThemeSwitch.astro';
const path = Astro.url.pathname;
const nav = [
  ['/', 'Timeline'], ['/entries/', 'Entries'], ['/makers/', 'Makers'], ['/formats/', 'Formats'],
  ['/physics/', 'How it works'], ['/landmarks/', 'Landmarks'], ['/glossary/', 'Glossary'], ['/sources/', 'Sources'],
] as const;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-head">
  <div class="wrap row">
    <a class="brand" href="/" aria-label="Photography Through Time, home">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="9.5" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="11" cy="11" r="3.2" fill="currentColor"/></svg>
      <span>Photography <em>Through</em> Time</span>
    </a>
    <nav aria-label="Sections">
      <ul>
        {nav.map(([href, label]) => <li><a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <a class="search-link" href="/search/" aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="10.8" y1="10.8" x2="14.5" y2="14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span>Search</span>
      </a>
      <ThemeSwitch />
    </div>
  </div>
</header>
<style>
  .site-head { border-bottom: 1px solid var(--rule-soft); background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(6px); position: sticky; top: 0; z-index: 30; }
  .row { display: flex; align-items: center; gap: 10px 22px; flex-wrap: wrap; padding-block: 10px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); border: 0; font: 400 19px/1 var(--font-display); white-space: nowrap; }
  .brand em { color: var(--accent); }
  .brand svg { color: var(--accent); }
  nav { flex: 1 1 auto; min-width: 0; }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 2px 4px; margin: 0; padding: 0; }
  nav a { display: inline-block; padding: 6px 9px; border-radius: 999px; border: 0; color: var(--ink-2); font-size: 13.5px; }
  nav a:hover { color: var(--ink); background: var(--rule-soft); }
  nav a[aria-current="page"] { color: var(--ink); background: var(--band); }
  .tools { display: flex; align-items: center; gap: 10px; }
  .search-link { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); border: 1px solid var(--rule); border-radius: 999px; padding: 6px 11px; font-size: 13px; }
  .search-link:hover { color: var(--ink); border-color: var(--muted); }
  @media (max-width: 900px) {
    nav { order: 3; flex-basis: 100%; overflow-x: auto; }
    nav ul { flex-wrap: nowrap; }
    nav a { white-space: nowrap; }
    .tools { margin-left: auto; }
    .search-link span { display: none; }
  }
</style>
