{
  "name": "photography-history-timeline",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "João Pedro Sconetto <work@sconetto.me>",
  "homepage": "https://ptt.sconetto.me",
  "repository": { "type": "git", "url": "git+https://github.com/sconetto/photography-history-timeline.git" },
  "description": "Photography Through Time: an interactive star-chart timeline and knowledge base of photography's history, physics, formats and makers.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "links": "node scripts/check-links.ts",
    "i18n:status": "node scripts/i18n-status.ts",
    "wiki:langlinks": "node scripts/wiki-langlinks.ts",
    "commons": "node scripts/commons.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "pagefind": "1.6.0",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  }
}
